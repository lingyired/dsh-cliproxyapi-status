{
  "name": "dsh-cliproxyapi-status",
  "version": "0.1.0",
  "description": "CLIProxyAPI status in the dsh settings panel: expiry-router account ranking and quota windows, the applied model list, and the OAuth credentials CPA holds",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node --test lib/index.test.js"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
